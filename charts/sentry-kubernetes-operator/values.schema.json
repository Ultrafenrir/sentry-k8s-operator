{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["production", "image", "registration", "registrationGateway", "registrationMonitoring", "controllerMonitoring"],
  "properties": {
    "production": {"type": "boolean"},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1, "pattern": "^[^@[:space:]]+$"},
        "tag": {"type": "string", "minLength": 1, "pattern": "^[^@[:space:]]+$"},
        "digest": {"type": "string", "pattern": "^$|^sha256:[0-9a-f]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}}
    },
    "registrationGateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "gatewayName", "gatewayNamespace", "listenerName", "telegramHostname", "sentryHostname"],
      "properties": {
        "enabled": {"type": "boolean"},
        "gatewayName": {"type": "string"},
        "gatewayNamespace": {"type": "string"},
        "listenerName": {"type": "string"},
        "telegramHostname": {"type": "string"},
        "sentryHostname": {"type": "string"}
      }
    },
    "registrationMonitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}}
    },
    "controllerMonitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "access"],
      "properties": {
        "enabled": {"type": "boolean"},
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "serviceAccountName", "serviceAccountNamespace"],
          "properties": {
            "enabled": {"type": "boolean"},
            "serviceAccountName": {"type": "string"},
            "serviceAccountNamespace": {"type": "string"}
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"production": {"const": true}}},
      "then": {
        "properties": {
          "image": {
            "properties": {
              "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "registrationMonitoring": {
            "properties": {"enabled": {"const": true}}
          }
        }
      },
      "then": {
        "properties": {
          "registration": {
            "properties": {"enabled": {"const": true}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "registrationGateway": {
            "properties": {"enabled": {"const": true}}
          }
        }
      },
      "then": {
        "properties": {
          "registration": {
            "properties": {"enabled": {"const": true}}
          },
          "registrationGateway": {
            "properties": {
              "gatewayName": {
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
              },
              "gatewayNamespace": {
                "minLength": 1,
                "maxLength": 63,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "listenerName": {
                "minLength": 1,
                "maxLength": 63,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "telegramHostname": {
                "minLength": 3,
                "maxLength": 253,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)+$"
              },
              "sentryHostname": {
                "minLength": 3,
                "maxLength": 253,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)+$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "controllerMonitoring": {
            "properties": {
              "access": {
                "properties": {"enabled": {"const": true}}
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "controllerMonitoring": {
            "properties": {
              "enabled": {"const": true},
              "access": {
                "properties": {
                  "serviceAccountName": {
                    "minLength": 1,
                    "maxLength": 253,
                    "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                  },
                  "serviceAccountNamespace": {
                    "minLength": 1,
                    "maxLength": 63,
                    "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
